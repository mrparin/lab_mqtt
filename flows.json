    {
        "id": "c38ec14145e885c1",
        "type": "function",
        "z": "66f84989428d9eb6",
        "name": "function 1",
        "func": "// แยกส่วนของ topic\n// ตัวอย่าง topic: smartfarm/durian_farm_01/zone_A/node_01/telemetry\nlet topicParts = msg.topic.split(\"/\");\n\nlet siteId  = topicParts[1];\nlet zoneId  = topicParts[2];\nlet boardId = topicParts[3];\n\n// จำ target ล่าสุดไว้ให้ปุ่มสั่งรีเลย์ใช้งานแบบ dynamic\nif (siteId && zoneId && boardId) {\n    flow.set(\"targetSiteId\", siteId);\n    flow.set(\"targetZoneId\", zoneId);\n    flow.set(\"targetBoardId\", boardId);\n}\n\n// อ่านค่าจาก payload\nlet temp = msg.payload.temperature;\nlet humi = msg.payload.humidity;\nlet soil = msg.payload.soil_moisture;\n\n// ส่งข้อมูลออก 3 output\nreturn [\n    {\n        topic: `${siteId}/${zoneId}/${boardId}/Temp`,\n        payload: temp\n    },\n    {\n        topic: `${siteId}/${zoneId}/${boardId}/Humi`,\n        payload: humi\n    },\n    {\n        topic: `${siteId}/${zoneId}/${boardId}/Soil`,\n        payload: soil\n    }\n];\n\n//หรือ ป้องกันการผิดพลาด ให้ตรวจสอบก่อนว่าข้อมูลทีเข้ามาเป้น string หรือเปล่า\n//ถ้าเป็น string ต้องเปลี่ยนเป็น json object \n// let data = msg.payload;\n\n// if (typeof data === \"string\") {\n//     data = JSON.parse(data);\n// }\n\n// let msgTemp  = { payload: data.Temp };\n// let msgHumid = { payload: data.Humi };\n// let msgSoil  = { payload: data.Soil };\n\n// return [msgTemp, msgHumid, msgSoil];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
