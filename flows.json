                "d11e035526b97353"
            ]
        ]
    },
    {
        "id": "a3f7be5e80ea9fd1",
        "type": "function",
        "z": "66f84989428d9eb6",
        "name": "build pump cmd",
        "func": "// Manual pump command only works while mode is manual\nconst mode = flow.get(\"controlMode\") || \"manual\";\nif (mode !== \"manual\") {\n    return null;\n}\n\nconst siteId = flow.get(\"targetSiteId\") || \"siteA\";\nconst zoneId = flow.get(\"targetZoneId\") || \"zone1\";\nconst boardId = flow.get(\"targetBoardId\") || \"device01\";\n\nmsg.topic = `smartfarm/${siteId}/${zoneId}/${boardId}/cmd`;\nmsg.payload = { mode: \"manual\", pump: msg.payload ? 1 : 0 };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 560,
        "wires": [
            [
                "fd13dc41d3273c8a",
                "d11e035526b97353"
            ]
        ]
    },
    {
        "id": "efc1767457d4ba57",
        "type": "function",
        "z": "66f84989428d9eb6",
        "name": "auto pump by soil",
        "func": "const mode = flow.get(\"controlMode\") || \"manual\";\nif (mode !== \"auto\") {\n    return null;\n}\n\nconst soil = Number(msg.payload);\nif (Number.isNaN(soil)) {\n    return null;\n}\n\nconst onThreshold = 30;\nconst offThreshold = 45;\nlet currentPump = flow.get(\"autoPumpState\");\nif (currentPump !== 0 && currentPump !== 1) {\n    currentPump = 0;\n}\n\nlet nextPump = currentPump;\nif (soil <= onThreshold) {\n    nextPump = 1;\n} else if (soil >= offThreshold) {\n    nextPump = 0;\n}\n\nif (nextPump === currentPump) {\n    return null;\n}\n\nflow.set(\"autoPumpState\", nextPump);\n\nconst siteId = flow.get(\"targetSiteId\") || \"siteA\";\nconst zoneId = flow.get(\"targetZoneId\") || \"zone1\";\nconst boardId = flow.get(\"targetBoardId\") || \"device01\";\n\nmsg.topic = `smartfarm/${siteId}/${zoneId}/${boardId}/cmd`;\nmsg.payload = { mode: \"auto\", pump: nextPump };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 420,
        "wires": [
            [
                "fd13dc41d3273c8a",
                "d11e035526b97353"
            ]
        ]
