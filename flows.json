    {
        "id": "a9ea47f02ff8ea70",
        "type": "function",
        "z": "66f84989428d9eb6",
        "name": "build mode cmd",
        "func": "const siteId = flow.get(\"targetSiteId\") || \"siteA\";\nconst zoneId = flow.get(\"targetZoneId\") || \"zone1\";\nconst boardId = flow.get(\"targetBoardId\") || \"device01\";\n\nconst mode = msg.payload ? \"auto\" : \"manual\";\nflow.set(\"controlMode\", mode);\n\nmsg.topic = `smartfarm/${siteId}/${zoneId}/${boardId}/cmd`;\nmsg.payload = { mode: mode };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 500,
        "wires": [
