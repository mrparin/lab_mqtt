    {
        "id": "8e553245816be15b",
        "type": "function",
        "z": "66f84989428d9eb6",
        "name": "function 2",
        "func": "// msg.payload ถูกโหนด json แปลงเป็น Object มาให้แล้ว ดึงค่าได้เลย\nlet msgTemp  = { payload: msg.payload.Temp };\nlet msgHumid = { payload: msg.payload.Humi };\nlet msgSoil  = { payload: msg.payload.Soil };\n\n// ส่งข้อมูลออก 3 ช่องตามลำดับ (บน, กลาง, ล่าง)\nreturn [msgTemp, msgHumid, msgSoil];\n\n\n//หรือ ป้องกันการผิดพลาด ให้ตรวจสอบก่อนว่าข้อมูลทีเข้ามาเป้น string หรือเปล่า\n//ถ้าเป็น string ต้องเปลี่ยนเป็น json object \n// let data = msg.payload;\n\n// if (typeof data === \"string\") {\n//     data = JSON.parse(data);\n// }\n\n// let msgTemp  = { payload: data.Temp };\n// let msgHumid = { payload: data.Humi };\n// let msgSoil  = { payload: data.Soil };\n\n// return [msgTemp, msgHumid, msgSoil];",
